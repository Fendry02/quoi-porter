{
  "expo": {
    "name": "QuoiPorter",
    "slug": "weather-clothes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/weather-clothes-icon.png",
    "scheme": "weather-clothes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "K2LUP8LQQY",
      "bundleIdentifier": "com.weatherclothes.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ta position permet de proposer une tenue adaptée à la météo locale.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.weatherclothes.app",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/weather-clothes-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayOutfit",
              "displayName": "Tenue du jour",
              "description": "La tenue conseillée et les points d’attention pour aujourd’hui.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayOutfit",
              "label": "Tenue du jour",
              "description": "La tenue conseillée et les points d’attention pour aujourd’hui.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCEEFF",
          "image": "./assets/images/weather-clothes-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.weatherclothes.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.weatherclothes.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9f4e9bce-af7e-42df-b88a-a5fe54ab1dfb"
      }
    },
    "owner": "fendry"
  }
}
