{
  "expo": {
    "name": "Qu'est-ce que je mets ?",
    "slug": "weather-clothes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/weather-clothes-icon.png",
    "scheme": "weather-clothes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.weatherclothes.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ta position permet de proposer une tenue adaptée à la météo locale."
      }
    },
    "android": {
      "package": "com.weatherclothes.app",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/weather-clothes-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "TodayOutfit",
              "displayName": "Tenue du jour",
              "description": "La tenue conseillée et les points d’attention pour aujourd’hui.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TodayOutfit",
              "label": "Tenue du jour",
              "description": "La tenue conseillée et les points d’attention pour aujourd’hui.",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCEEFF",
          "image": "./assets/images/weather-clothes-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
